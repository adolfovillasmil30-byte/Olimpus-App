{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with trial and subscription status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user UID" },
        "email": { "type": "string", "format": "email", "description": "The user email" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role" },
        "status": { "type": "string", "enum": ["trial", "active", "suspended"], "description": "Subscription status" },
        "createdAt": { "type": "number", "description": "Creation timestamp in ms" },
        "trialEndDate": { "type": "number", "description": "Trial expiration timestamp in ms" }
      },
      "required": ["uid", "email", "role", "status", "createdAt", "trialEndDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account document containing subscription and trial info"
    }
  }
}
