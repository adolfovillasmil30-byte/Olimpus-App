rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection and subcollections (strictly isolated per user)
    match /users/{userId} {
      // User profile
      allow get: if isOwner(userId);
      
      // Initial profile creation upon registration
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.status in ['trial', 'active', 'suspended']
        && request.resource.data.role in ['user', 'admin'];

      // User status updates (e.g. trial expiration update)
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;
        
      allow delete: if false;

      // Workouts subcollection: users/{userId}/workouts/{workoutId}
      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }

      // Attendance subcollection: users/{userId}/attendance/{attendanceId}
      match /attendance/{attendanceId} {
        allow read, write: if isOwner(userId);
      }

      // Meals subcollection: users/{userId}/meals/{mealId}
      match /meals/{mealId} {
        allow read, write: if isOwner(userId);
      }

      // Progress subcollection: users/{userId}/progress/{progressId}
      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all for any user-scoped subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
